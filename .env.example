WEB_PORT=8081

# CodeIgniter
CI_INDEX_PAGE=
CI_URI_PROTOCOL=REQUEST_URI
APP_CHARSET=UTF-8
APP_LANGUAGE=english
CI_ENCRYPTION_KEY=stripedesk_dev_change_me
CI_ENABLE_HOOKS=false
CI_LOG_THRESHOLD=0
CI_LOG_PATH=
CI_DB_DEBUG=

# Database (app reads .env via bootstrap_env.php; DB_* preferred, MYSQL_* fallback for Docker)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=stripedesk
DB_USERNAME=stripedesk
DB_PASSWORD=stripedesk
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

DB_DRIVER=mysqli
DB_ACTIVE_GROUP=default
DB_QUERY_BUILDER=true
DB_DSN=
DB_PREFIX=
DB_CACHEDIR=
DB_SWAP_PRE=
DB_PCONNECT=false
DB_CACHE_ON=false
DB_ENCRYPT=false
DB_COMPRESS=false
DB_STRICTON=false
DB_SAVE_QUERIES=true

# Docker MySQL image init (optional duplicate of DB_* for compose)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=stripedesk
MYSQL_USER=stripedesk
MYSQL_PASSWORD=stripedesk
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_ROOT_PASSWORD=root

# API JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_TTL=86400
JWT_ISSUER=stripedesk

# OTP / password reset
OTP_TTL_SECONDS=600
RESET_TOKEN_TTL_SECONDS=900
# Dev only: return otp in API response for testing
OTP_DEV_RETURN_CODE=false

MAIL_FROM_ADDRESS=noreply@stripedesk.com
MAIL_FROM_NAME=StripeDesk
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls | ssl | (empty to disable TLS auto for local SMTP)
MAIL_ENCRYPTION=tls

CORS_ALLOW_ORIGIN=http://localhost:5173,https://stripedesk.duolinkmm.com

# Auth cookie
AUTH_ACCESS_COOKIE_NAME=stripedesk_access_token
AUTH_REFRESH_COOKIE_NAME=stripedesk_refresh_token
AUTH_COOKIE_SAMESITE=None
AUTH_COOKIE_SECURE=true

# Token TTLs (seconds)
JWT_REFRESH_TTL=2592000

# Stripe (required for payments)
STRIPE_SECRET_KEY=
# If empty, webhook signature verification is skipped (dev only)
STRIPE_WEBHOOK_SECRET=
# Where Stripe redirects after checkout (use your SPA URL + /shop/success, not the API origin)
STRIPE_SUCCESS_URL=http://localhost:5173/shop/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/purchase/cancel

# Optional: require this token as 3rd CLI arg for cron (php public/index.php cron stripe_reconcile YOUR_TOKEN)
CRON_STRIPE_RECONCILE_TOKEN=
