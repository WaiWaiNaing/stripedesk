WEB_PORT=8081

# CodeIgniter
CI_INDEX_PAGE=
CI_URI_PROTOCOL=REQUEST_URI
APP_CHARSET=UTF-8
APP_LANGUAGE=english
CI_ENCRYPTION_KEY=stripedesk_dev_change_me
CI_ENABLE_HOOKS=false
CI_LOG_THRESHOLD=0
CI_LOG_PATH=
CI_DB_DEBUG=

# Database (app reads .env via bootstrap_env.php; DB_* preferred, MYSQL_* fallback for Docker)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=stripedesk
DB_USERNAME=stripedesk
DB_PASSWORD=stripedesk
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

DB_DRIVER=mysqli
DB_ACTIVE_GROUP=default
DB_QUERY_BUILDER=true
DB_DSN=
DB_PREFIX=
DB_CACHEDIR=
DB_SWAP_PRE=
DB_PCONNECT=false
DB_CACHE_ON=false
DB_ENCRYPT=false
DB_COMPRESS=false
DB_STRICTON=false
DB_SAVE_QUERIES=true

# Docker MySQL image init (optional duplicate of DB_* for compose)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=stripedesk
MYSQL_USER=stripedesk
MYSQL_PASSWORD=stripedesk
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_ROOT_PASSWORD=root

# API JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_TTL=86400
JWT_ISSUER=stripedesk
